@echo off
chcp 65001 >nul
title PRO-INSTALL - ระบบสำรองข้อมูล Cloudflare D1 Database
color 0E

echo ======================================================================
echo          💾 PRO-INSTALL - ระบบสำรองข้อมูล Cloudflare D1 Database
echo ======================================================================
echo.
echo  กำลังเชื่อมต่อและดาวน์โหลดข้อมูลจริงจาก Cloudflare D1 (pro-install-db)...
echo.

cd /d "%~dp0"
npm run db:backup

if %errorlevel% equ 0 (
    color 0A
    echo.
    echo ======================================================================
    echo  ✅ สำรองข้อมูลเรียบร้อยแล้ว 100%%!
    echo  📁 ไฟล์สำรองถูกเก็บไว้ในโฟลเดอร์: %~dp0backups
    echo ======================================================================
) else (
    color 0C
    echo.
    echo ======================================================================
    echo  ❌ เกิดข้อผิดพลาดในการสำรองข้อมูล กรุณาตรวจสอบอินเทอร์เน็ต
    echo ======================================================================
)

echo.
echo กดปุ่มใดก็ได้เพื่อปิดหน้าต่างนี้...
pause >nul
